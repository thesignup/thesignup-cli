{
  "name": "thesignup",
  "version": "0.0.1",
  "description": "thesignup command-line tool",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/thesignup/thesignup-cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thesignup/thesignup-cli.git"
  },
  "bugs": "https://github.com/thesignup/thesignup-cli/issues",
  "license": "MIT",
  "bin": {
    "thesignup": "./bin/thesignup.cjs"
  },
  "files": [
    "bin",
    "scripts/postinstall.cjs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "//binaryChecksums": "SHA-256 of each prebuilt binary, verified by scripts/postinstall.cjs before install. Populate every entry at release time (e.g. `shasum -a 256 dist/*`); an empty value makes the install fail closed.",
  "binaryChecksums": {
    "thesignup-darwin-arm64": "",
    "thesignup-darwin-x64": "",
    "thesignup-linux-arm64": "",
    "thesignup-linux-x64": "",
    "thesignup-windows-x64.exe": ""
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/index.ts --compile --minify --outfile dist/thesignup",
    "build:all": "bun run build:darwin-arm64 && bun run build:darwin-x64 && bun run build:linux-arm64 && bun run build:linux-x64 && bun run build:win-x64",
    "build:darwin-arm64": "bun build src/index.ts --compile --minify --target=bun-darwin-arm64 --outfile dist/thesignup-darwin-arm64",
    "build:darwin-x64": "bun build src/index.ts --compile --minify --target=bun-darwin-x64 --outfile dist/thesignup-darwin-x64",
    "build:linux-arm64": "bun build src/index.ts --compile --minify --target=bun-linux-arm64 --outfile dist/thesignup-linux-arm64",
    "build:linux-x64": "bun build src/index.ts --compile --minify --target=bun-linux-x64 --outfile dist/thesignup-linux-x64",
    "build:win-x64": "bun build src/index.ts --compile --minify --target=bun-windows-x64 --outfile dist/thesignup-windows-x64.exe",
    "checksums": "node scripts/write-checksums.cjs",
    "postinstall": "node scripts/postinstall.cjs"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0",
    "commander": "^14.0.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
